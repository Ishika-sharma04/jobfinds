# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names are also accepted if your project only shows anon/service_role.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio Gemini API key (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional current USD per million tokens for the selected Gemini model.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=


# Starter boards use public ATS job-board APIs; review employer terms before deployment.
# Set false to disable starter boards. Add more public board slugs as slug:Company Name.
ATS_STARTER_BOARDS=true
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ASHBY_BOARDS=
# Optional permitted RSS feeds, comma-separated Publisher Name|https://feed-url
RSS_FEEDS=

# Optional shared secret required by the collection endpoint
CRON_SECRET=
# Optional reviewer secret required to submit accuracy evaluations
ADMIN_SECRET=
